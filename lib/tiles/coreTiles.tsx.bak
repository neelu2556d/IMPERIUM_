/** Where Library sits in the seeded default: the prominent second-row slot. */
export const LIBRARY_DEFAULT_INDEX = Math.max(0, DEFAULT_HOME_ORDER.indexOf(LIBRARY_TILE.id))

/** Where Forge sits in the seeded default: beside Library (the storefront). */
export const FORGE_DEFAULT_INDEX = Math.max(0, DEFAULT_HOME_ORDER.indexOf(FORGE_TILE.id))

/** The single ordered list of EVERY tile on a user's home dashboard: the pre-installed
 *  core tiles, the optional I tile, and the user's own built tiles, all interleaved in
 *  one order. The dashboard renders this list into one grid, so core tiles, I, and
 *  user tiles drag, resize, re-order, and can be removed as equals. Nothing is locked —
 *  I is just one optional tile now (Aikido pivot), re-addable from the Add-tile gallery
 *  if removed.
 *
 *  A fresh dashboard seeds with DEFAULT_HOME_ORDER (which reproduces the loved old
 *  composition once the seeded sizes + dense flow resolve).
 *
 *  v1 is localStorage, per user, mirroring tileStore / tileSkin so the same
 *  Supabase swap seam applies later.
 *
 *  Key:
 *    Imperium:<userId>:home  -> string[]  (all home tile ids, in display order)
 */
export const DEFAULT_HOME_ORDER: HomeTileId[] = [
  'train',
  'fuel',
  'library',
  'forge',
  'vitals',
  'finance',
  'business',
  'I',
]

/** Is this id one of the pre-installed core tiles (incl. I)? */
export function isCoreId(id: string): id is CoreTileId | 'I' {
  return id === 'I' || id in CORE_TILES
}

/** Is this id the special locked Forge tile (the Claude-builds-it storefront)? */
export const isForgeId = (id: string) => id === FORGE_TILE.id

/** Is this id any home tile (a core tile, I, or the locked Library / Create / Forge)? */
export const isHomeId = (id: string): id is HomeTileId =>
  isLibraryId(id) || isCreateId(id) || isForgeId(id) || isCoreId(id)

/** Default size for any home tile id. I defaults to the 2x2 centrepiece. */
export function coreDefaultSize(id: HomeTileId): TileSize {
  if (id === 'I') return 'big'
  if (id === 'library') return LIBRARY_TILE.defaultSize
  if (id === 'create') return CREATE_TILE.defaultSize
  if (id === 'forge') return FORGE_TILE.defaultSize
  return CORE_TILES[id].defaultSize
}
export const isLibraryId = (id: string): id is 'library' => id === 'library'
export const isCreateId = (id: string): id is 'create' => id === 'create'
export const isForgeId = (id: string): id is 'forge' => id === 'forge'